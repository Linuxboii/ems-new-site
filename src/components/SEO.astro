---
import { company } from '@/data/company';
interface Props { title: string; description: string; path: string; image?: string; jsonLd?: object[]; noindex?: boolean; }
const { title, description, path, image = '/social-card.jpg', jsonLd = [], noindex = false } = Astro.props;
const site = 'https://emstechnologies.in';
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;

const orgId = `${site}/#organization`;
const geoId = `${site}/#geo`;
const placeId = `${site}/#place`;
const principalId = `${site}/#principal`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: `${company.address.locality}, ${company.address.district}`,
  addressLocality: company.address.metro,
  addressRegion: company.address.region,
  postalCode: company.address.postalCode,
  addressCountry: company.address.country,
};

const geoCoordinates = {
  '@type': 'GeoCoordinates',
  '@id': geoId,
  latitude: company.geo.lat,
  longitude: company.geo.lng,
};

// Physical facility (office + factory) as a first-class Place so map/pin
// searches ("EMS Technologies location", "conformal coating factory Hyderabad")
// resolve to this exact spot.
const place = {
  '@type': 'Place',
  '@id': placeId,
  name: `${company.name} — Office & Factory`,
  address: postalAddress,
  geo: geoCoordinates,
  hasMap: company.mapUrl,
  additionalProperty: {
    '@type': 'PropertyValue',
    propertyID: 'plusCode',
    name: 'Google Plus Code',
    value: company.plusCode,
  },
};

// The German principal whose range EMS distributes in India. Published as its own
// node so answer engines can resolve the distributor→manufacturer relationship
// instead of inferring it from prose.
const principal = {
  '@type': 'Organization',
  '@id': principalId,
  name: company.principal.name,
  url: company.principal.url,
  sameAs: [company.principal.url],
  foundingDate: String(company.principal.founded),
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.principal.city,
    addressCountry: 'DE',
  },
  brand: { '@type': 'Brand', name: 'ELPEGUARD' },
};

// Organization: primary entity for search + generative engines. Explicit facts
// (founding, what we know about, who we distribute) help AI answer engines.
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization',
  '@id': orgId,
  name: company.name, legalName: company.legalName, url: site, logo: `${site}/logo.png`,
  image: ogImage, email: company.email, telephone: company.phones[0],
  foundingDate: String(company.since),
  slogan: company.tagline,
  description: company.description,
  address: postalAddress,
  location: { '@id': placeId },
  hasMap: company.mapUrl,
  areaServed: { '@type': 'Country', name: 'India' },
  knowsAbout: [
    'Conformal coating',
    'ELPEGUARD conformal coatings',
    'ESD packaging',
    'Anti-static packing',
    'Selective conformal coating machines',
    'Conformal coating job work',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: company.phones[0],
      email: company.email,
      areaServed: 'IN',
      availableLanguage: ['en', 'hi', 'te'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'technical support',
      telephone: company.phones[0],
      email: company.principalEmail,
      areaServed: 'IN',
      availableLanguage: ['en'],
    },
  ],
  // The distributor → principal link is carried by `description` and the
  // #principal node. The old makesOffer → Offer → Product had no price, which
  // the Rich Results Test flags as invalid on every page.
  ...(company.sameAs.length ? { sameAs: [...company.sameAs] } : {}),
};

const localBusiness = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  '@id': `${site}/#localbusiness`,
  name: company.name, image: ogImage, url: site, logo: `${site}/logo.png`,
  telephone: company.phones[0], email: company.email,
  address: postalAddress,
  geo: geoCoordinates,
  hasMap: company.mapUrl,
  location: { '@id': placeId },
  areaServed: 'IN',
  parentOrganization: { '@id': orgId },
};

const website = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site, name: company.name, inLanguage: 'en-IN',
  publisher: { '@id': orgId },
};

const graph = [organization, principal, place, localBusiness, website, ...jsonLd];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
<meta name="theme-color" content="#1e63c4" />

<!-- Geographic / local SEO: office & factory in Maheswaram, Hyderabad -->
<meta name="geo.region" content={company.address.regionCode} />
<meta name="geo.placename" content={`${company.address.locality}, ${company.address.metro}, ${company.address.region}`} />
<meta name="geo.position" content={`${company.geo.lat};${company.geo.lng}`} />
<meta name="ICBM" content={`${company.geo.lat}, ${company.geo.lng}`} />
<link rel="alternate" hreflang="en-in" href={canonical} />

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={company.name} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
