---
import { productIntros } from '@/data/productIntros';

interface Props { path: string; }
const { path } = Astro.props;
const paragraphs = productIntros[path];
---
{paragraphs && (
  /* Sits directly under the hero; the following `.section` supplies the gap below. */
  <section class="container-x pt-14 sm:pt-16">
    <div class="max-w-3xl space-y-5 text-muted">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>
)}
