---
import AssetImage from '@/components/AssetImage.astro';
interface Props { title: string; href: string; img: string; blurb?: string; }
const { title, href, img, blurb } = Astro.props;
---
<a href={href} class="card group flex flex-col overflow-hidden">
  <div class="aspect-[4/3] overflow-hidden bg-surface">
    <AssetImage name={img} alt={title} width={640} height={480} sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, 33vw" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="heading text-lg">{title}</h3>
    {blurb && <p class="mt-2 text-sm text-muted">{blurb}</p>}
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
      View
      <span class="text-accent2 transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
    </span>
  </div>
</a>
