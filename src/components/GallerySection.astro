---
import Lightbox from '@/components/Lightbox.astro';
import type { GalleryImage } from '@/data/gallery';
interface Props { title: string; blurb?: string; images: GalleryImage[]; id?: string; enquire?: string; }
const { title, blurb, images, id, enquire } = Astro.props;
---
<section class="section container-x" id={id}>
  <h2 class="heading text-2xl sm:text-3xl text-ink">{title}</h2>
  {blurb && <p class="mt-3 max-w-3xl text-muted">{blurb}</p>}
  <p class="mt-2 text-sm text-accent2">Click any photo to view it larger{enquire ? ', or Enquire to request details.' : '.'}</p>
  <div class="mt-8">
    <Lightbox images={images} enquire={enquire} />
  </div>
</section>
