---
import Lightbox from '@/components/Lightbox.astro';
import { productDetails } from '@/data/productDetails';
import type { GalleryImage } from '@/data/gallery';
interface Props { title: string; blurb?: string; images: GalleryImage[]; id?: string; enquire?: string; detailKey?: string; }
const { title, blurb, images, id, enquire, detailKey } = Astro.props;

// With a detailKey, opening any photo in this section shows the product
// write-up beside the enlarged image.
const detail = detailKey ? productDetails[detailKey] : undefined;
---
<section class="section container-x" id={id}>
  <h2 class="heading text-2xl sm:text-3xl text-ink">{title}</h2>
  {blurb && <p class="mt-3 max-w-3xl text-muted">{blurb}</p>}
  <p class="mt-2 text-sm text-accent2">
    Click any photo to view it larger{detail ? ' with the full product details' : ''}{enquire ? ', or Enquire to request a quote.' : '.'}
  </p>
  <div class="mt-8">
    <Lightbox images={images} enquire={enquire} detail={detail} detailLabel={title} />
  </div>
</section>
