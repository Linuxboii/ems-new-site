---
import AssetImage from '@/components/AssetImage.astro';
import { clients } from '@/data/clients';
const loop = [...clients, ...clients];
---
<div class="marquee-wrap relative overflow-hidden py-4" aria-label="Our clients">
  <div class="marquee-track flex w-max gap-10">
    {loop.map((c, i) => (
      <div class="marquee-item grid h-16 w-32 shrink-0 place-items-center grayscale opacity-70 transition duration-300">
        <AssetImage name={c} alt={`Client ${(i % clients.length) + 1}`} width={128} height={64} class="max-h-16 w-auto object-contain" />
      </div>
    ))}
  </div>
</div>
<style>
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-track {
    animation: marquee 40s linear infinite;
    will-change: transform;
  }
  /* Freeze the belt while pointing at it so a logo can't slide out from under the cursor. */
  .marquee-wrap:hover .marquee-track { animation-play-state: paused; }
  /* Colour reveal only fires on the item actually under the cursor (now stationary). */
  .marquee-item:hover { opacity: 1; filter: grayscale(0); }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none !important; flex-wrap: wrap; justify-content: center; }
  }
</style>
