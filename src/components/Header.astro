---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { nav } from '@/data/nav';

const cur = (() => {
  const p = Astro.url.pathname;
  return p.length > 1 ? p.replace(/\/$/, '') : p;
})();
const isActive = (href: string) => {
  const h = href.length > 1 ? href.replace(/\/$/, '') : href;
  return h === '/' ? cur === '/' : cur === h || cur.startsWith(h + '/');
};
const groupActive = (item: (typeof nav)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---
<header id="siteHeader" class="sticky top-0 z-50 bg-paper/85 backdrop-blur border-b border-line transition-shadow">
  <div class="container-x flex items-center justify-between h-28">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="EMS Technologies home">
      <!-- Rendered at 2x the displayed height so the mark stays sharp on retina screens. -->
      <Image src={logo} alt="EMS Technologies logo" height={176} class="site-logo h-[72px] sm:h-[88px] w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) => (
        item.children ? (
          <div class="menu relative" data-menu>
            <div class="flex items-center">
              <a
                href={item.href}
                class:list={['px-3 py-2 rounded-lg font-medium transition', groupActive(item) ? 'text-accent2' : 'text-ink hover:text-accent2 hover:bg-line']}
                aria-current={groupActive(item) ? 'page' : undefined}
              >{item.label}</a>
              <button
                type="button"
                class="menu-caret p-1.5 rounded-lg text-muted hover:text-accent2 hover:bg-line"
                data-menu-toggle
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={`Toggle ${item.label} menu`}
              >
                <svg class="caret-ico h-4 w-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>
            <div class="menu-panel absolute left-0 top-full pt-2" data-menu-panel>
              <div class="min-w-64 rounded-xl border border-line bg-surface p-2 shadow-xl shadow-brand-900/10">
                {item.children.map((c) => (
                  <a
                    href={c.href}
                    class:list={['block rounded-lg px-3 py-2 text-sm transition', isActive(c.href) ? 'bg-line text-accent2 font-medium' : 'text-muted hover:bg-line hover:text-accent2']}
                    aria-current={isActive(c.href) ? 'page' : undefined}
                  >{c.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={['px-3 py-2 rounded-lg font-medium transition', isActive(item.href) ? 'text-accent2' : 'text-ink hover:text-accent2 hover:bg-line']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >{item.label}</a>
        )
      ))}
      <button type="button" class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink hover:bg-line transition" data-theme-toggle aria-label="Switch theme">
        <svg class="ico-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="ico-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="/contact-us/" class="btn-primary text-sm ml-1 !px-5 !py-2 !min-h-0">Get a Quote</a>
    </nav>

    <!-- Mobile toggle -->
    <button id="navToggle" class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg min-h-[44px] min-w-[44px] text-ink hover:bg-line" aria-label="Open menu" aria-controls="navDrawer" aria-expanded="false">
      <svg class="ico-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="ico-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div id="navDrawer" class="lg:hidden overflow-hidden max-h-0 border-t border-transparent bg-surface transition-[max-height] duration-300 ease-in-out">
    <nav class="container-x py-2 flex flex-col" aria-label="Mobile">
      {nav.map((item) => (
        item.children ? (
          <div class="border-b border-line" data-m-item>
            <div class="flex items-center justify-between">
              <a href={item.href} class:list={['block flex-1 py-3 font-medium', groupActive(item) ? 'text-accent2' : 'text-ink']}>{item.label}</a>
              <button type="button" class="p-3 -mr-2 text-muted" data-m-toggle aria-expanded="false" aria-label={`Toggle ${item.label} submenu`}>
                <svg class="h-5 w-5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>
            <div class="hidden pb-2 pl-3" data-m-sub>
              {item.children.map((c) => (
                <a href={c.href} class:list={['block py-2 text-sm', isActive(c.href) ? 'text-accent2 font-medium' : 'text-muted']}>{c.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['block py-3 font-medium border-b border-line', isActive(item.href) ? 'text-accent2' : 'text-ink']}>{item.label}</a>
        )
      ))}
      <button type="button" class="flex items-center gap-3 py-3 font-medium text-ink border-b border-line" data-theme-toggle aria-label="Switch theme">
        <svg class="ico-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="ico-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <span class="ico-moon">Dark theme</span><span class="ico-sun">Light theme</span>
      </button>
      <a href="/contact-us/" class="btn-primary mt-4 mb-3">Get a Quote</a>
    </nav>
  </div>

  <style>
    /* Logo sits straight on the header — the PNG is transparent, no plate behind it.
       Dark theme flips the navy mark to white so it stays legible. */
    :root[data-theme='dark'] .site-logo { filter: brightness(0) invert(1); }
    .menu-panel { opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .18s ease, transform .18s ease, visibility .18s; }
    .menu:hover .menu-panel,
    .menu:focus-within .menu-panel,
    .menu.open .menu-panel { opacity: 1; visibility: visible; transform: translateY(0); }
    .menu:hover .caret-ico,
    .menu.open .caret-ico { transform: rotate(180deg); }
    @media (prefers-reduced-motion: reduce) {
      .menu-panel, #navDrawer, .caret-ico { transition: none !important; }
    }
  </style>

  <script>
    // Elevate header once the page is scrolled.
    const header = document.getElementById('siteHeader');
    const onScroll = () => header?.classList.toggle('shadow-md', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Light / dark theme toggle (persisted; default light).
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (dark) { document.documentElement.removeAttribute('data-theme'); try { localStorage.setItem('theme', 'light'); } catch (e) {} }
        else { document.documentElement.setAttribute('data-theme', 'dark'); try { localStorage.setItem('theme', 'dark'); } catch (e) {} }
      });
    });

    // Desktop dropdowns: hover (CSS) + click/keyboard toggle (JS).
    const menus = Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));
    const closeMenus = (except?: HTMLElement) => {
      menus.forEach((m) => {
        if (m === except) return;
        m.classList.remove('open');
        m.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', 'false');
      });
    };
    menus.forEach((menu) => {
      const toggle = menu.querySelector('[data-menu-toggle]');
      toggle?.addEventListener('click', (e) => {
        e.preventDefault();
        const open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        if (open) closeMenus(menu);
      });
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      menus.forEach((m) => { if (!m.contains(t)) { m.classList.remove('open'); m.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', 'false'); } });
    });

    // Mobile drawer.
    const btn = document.getElementById('navToggle');
    const drawer = document.getElementById('navDrawer');
    const iconOpen = btn?.querySelector('.ico-open');
    const iconClose = btn?.querySelector('.ico-close');
    let drawerOpen = false;
    const syncHeight = () => { if (drawer && drawerOpen) drawer.style.maxHeight = drawer.scrollHeight + 'px'; };
    const setDrawer = (open: boolean) => {
      drawerOpen = open;
      if (!drawer) return;
      drawer.style.maxHeight = open ? drawer.scrollHeight + 'px' : '0px';
      drawer.classList.toggle('border-line', open);
      drawer.classList.toggle('border-transparent', !open);
      btn?.setAttribute('aria-expanded', String(open));
      btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };
    btn?.addEventListener('click', () => setDrawer(!drawerOpen));
    drawer?.querySelectorAll<HTMLElement>('[data-m-toggle]').forEach((t) => {
      t.addEventListener('click', () => {
        const sub = t.closest('[data-m-item]')?.querySelector('[data-m-sub]');
        const caret = t.querySelector('svg');
        const expanded = sub?.classList.toggle('hidden') === false;
        t.setAttribute('aria-expanded', String(expanded));
        if (caret) caret.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
        syncHeight();
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeMenus();
      if (drawerOpen) setDrawer(false);
    });
  </script>
</header>
