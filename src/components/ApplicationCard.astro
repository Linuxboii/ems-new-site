---
import AssetImage from '@/components/AssetImage.astro';
import MagnifyImage from '@/components/MagnifyImage.astro';
import CardModal from '@/components/CardModal.astro';

interface Props { title: string; img: string; body: string; detail: string; points?: string[]; id: string; eyebrow?: string; enquirePrefix?: string; }
const { title, img, body, detail, points = [], id, eyebrow = 'Application', enquirePrefix = 'ESD Paint' } = Astro.props;
const dialogId = `ac-${id}`;
---
<article class="card ac overflow-hidden">
  <button type="button" class="ac-open block w-full text-left" data-ac-open={dialogId} aria-haspopup="dialog">
    <div class="aspect-[4/3] overflow-hidden bg-surface">
      <AssetImage name={img} alt={title} width={480} height={360} class="h-full w-full object-cover transition duration-500" />
    </div>
    <div class="p-6">
      <div class="flex items-start justify-between gap-3">
        <h3 class="heading text-lg">{title}</h3>
        <svg class="mt-1 shrink-0 text-accent2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </div>
      <p class="mt-2 text-sm text-muted">{body}</p>
      <span class="mt-3 inline-block text-xs font-medium text-accent2" aria-hidden="true">Read more &rarr;</span>
    </div>
  </button>
</article>

<CardModal id={dialogId}>
  <MagnifyImage slot="figure" name={img} alt={title} width={900} height={675} />
  <p class="eyebrow">{eyebrow}</p>
  <h3 id={`${dialogId}-title`} class="heading mt-4 text-2xl">{title}</h3>
  <p class="mt-4 text-sm text-muted">{detail}</p>
  {points.length > 0 && (
    <ul class="mt-5 space-y-2.5 text-sm text-muted">
      {points.map((p) => (
        <li class="flex gap-3"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent2"></span><span>{p}</span></li>
      ))}
    </ul>
  )}
  <a href={`/contact-us/?product=${encodeURIComponent(`${enquirePrefix} — ${title}`)}`} class="btn-primary mt-7">Enquire about this</a>
</CardModal>

<style>
  .ac-open { cursor: pointer; }
  .ac-open:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  .ac:hover img { transform: scale(1.03); }
</style>
