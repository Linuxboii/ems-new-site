---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ProductIntro from '@/components/ProductIntro.astro';
import GallerySection from '@/components/GallerySection.astro';
import { gallery } from '@/data/gallery';
import { galleryJsonLd, breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'PP Corrugated Trays and Bins - ESD Storage & Transport | EMS Technologies';
const description = 'PP corrugated ESD trays and bins from EMS Technologies, Hyderabad: lightweight, reusable anti-static corrugated packaging for storing and transporting PCBs and components.';
const path = '/products/pp-corrugated/';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    { name: 'PP Corrugated Trays and Bins', path },
  ]),
  await galleryJsonLd('PP Corrugated Trays and Bins', description, path, [gallery.ppCorrugated]),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="ESD Packing" title="PP Corrugated Trays and Bins" lead="Lightweight, reusable polypropylene corrugated trays and bins for storing and transporting circuit boards and components. Anti-static and clearly labelled for electrostatic-sensitive devices." />
  <ProductIntro path={path} />
  <GallerySection detailKey="pp-corrugated" title="PP Corrugated Trays &amp; Bins" enquire="PP Corrugated Trays and Bins" images={gallery.ppCorrugated.images} blurb="Anti-static PP corrugated trays with perforated and slotted conductive bases, labelled for electrostatic-sensitive devices." />
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Need a size or layout for your components?</h2>
      <a href="/contact-us/?product=PP%20Corrugated%20Trays%20and%20Bins" class="btn-primary mt-7">Request a quote</a>
    </div>
  </section>
</Layout>
