---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import GallerySection from '@/components/GallerySection.astro';
import { gallery } from '@/data/gallery';
import { galleryJsonLd, breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'PP Corrugated Trays & Bins - ESD Component Storage | EMS Technologies';
const description = 'Durable polypropylene corrugated ESD trays and bins from EMS Technologies, Hyderabad, offering electrostatic-sensitive-device labelled storage and transport for PCBs and components.';
const path = '/products/pp-bins/';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    { name: 'PP Corrugated Trays & Bins', path },
  ]),
  await galleryJsonLd('PP Corrugated Trays & Bins', description, path, [gallery.bins]),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="ESD Packing" title="PP Corrugated Trays & Bins" lead="Rugged, reusable polypropylene corrugated bins and trays for storing and transporting circuit boards and components. ESD-safe and clearly labelled for electrostatic-sensitive devices." />
  <GallerySection title="PP Corrugated ESD Bins" enquire="PP Corrugated Trays & Bins" images={gallery.bins.images} blurb="Anti-static corrugated bins holding assembled PCBs, labelled for electrostatic-sensitive devices." />
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Need a size or layout for your components?</h2>
      <a href="/contact-us/?product=PP%20Corrugated%20Trays%20%26%20Bins" class="btn-primary mt-7">Request a quote</a>
    </div>
  </section>
</Layout>
