---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ProductIntro from '@/components/ProductIntro.astro';
import GallerySection from '@/components/GallerySection.astro';
import { gallery } from '@/data/gallery';
import { galleryJsonLd, breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'EPE Foam Trays - Static-Safe Handling | EMS Technologies';
const description = 'EPE foam trays and inserts from EMS Technologies, Hyderabad, cut to component geometry for secure, static-safe handling and transport of sensitive electronics.';
const path = '/products/conductive-foam-trays/';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    { name: 'EPE Foam Trays', path },
  ]),
  await galleryJsonLd('EPE Foam Trays', description, path, [gallery.evafoam]),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="ESD Packing" title="EPE Foam Trays" lead="EPE foam inserts and trays cut precisely to component geometry, giving cushioning and continuous static dissipation for secure device handling." />
  <ProductIntro path={path} />
  <GallerySection detailKey="epe-foam-trays" title="EPE Foam Trays" enquire="EPE Foam Trays" images={gallery.evafoam.images} blurb="Blue EPE foam inserts routed to hold parts snugly and dissipate static." />
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Custom foam for your parts?</h2>
      <a href="/contact-us/?product=EPE%20Foam%20Trays" class="btn-primary mt-7">Request a quote</a>
    </div>
  </section>
</Layout>
