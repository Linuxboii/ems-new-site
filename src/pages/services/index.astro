---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ProductCard from '@/components/ProductCard.astro';

const title = 'Services - Conformal Coating & ESD Paint Job Work | EMS';
const description = 'EMS Technologies job work services: end-to-end conformal coating of PCB assemblies and on-site application of ProtectA Pro ESD conductive and anti-static paints.';

const jobWork = [
  {
    title: 'Conformal Coating Job Work',
    href: '/services/conformal-coating-job-work/',
    img: '2019-services-hires-coating.jpg',
    blurb: 'Application, UV optical inspection, curing, thickness testing, removal and final inspection, delivered on site by 30+ trained engineers.',
  },
  {
    title: 'ESD Paint Job Work',
    href: '/services/esd-paint-job-work/',
    img: 'bins.png',
    blurb: 'ProtectA Pro ESD conductive and anti-static paints applied to floors, walls, work surfaces and bins, with earthing and resistance testing.',
  },
];
---
<Layout title={title} description={description} path="/services/">
  <PageHero eyebrow="Job work" title="Services" lead="Two on-site job work programmes: protective conformal coating of assembled PCBs, and ESD conductive paint systems for the environment those boards are built in." />
  <section class="section container-x">
    <div class="grid gap-6 sm:grid-cols-2">
      {jobWork.map((s) => <ProductCard title={s.title} href={s.href} img={s.img} blurb={s.blurb} />)}
    </div>
  </section>
</Layout>
