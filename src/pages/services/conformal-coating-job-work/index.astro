---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ApplicationCard from '@/components/ApplicationCard.astro';
import { services, serviceIntro } from '@/data/services';
import { breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'Conformal Coating Job Work - On-Site Coating Services | EMS';
const description = 'EMS Technologies provides end-to-end conformal coating job work: application, UV optical inspection, curing, thickness testing, removal and final inspection by 30+ trained engineers.';
const path = '/services/conformal-coating-job-work/';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: 'Conformal Coating Job Work', path },
  ]),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="Services · Job work" title="Conformal Coating Job Work" lead={serviceIntro} />
  <section class="section container-x">
    <p class="eyebrow">Process</p>
    <h2 class="heading mt-4 text-2xl sm:text-3xl">What the job work covers</h2>
    <p class="mt-3 text-sm text-accent2">Click any card to read more about that step.</p>
    <div class="mt-8 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <ApplicationCard id={`cc-${i}`} title={s.title} img={s.img} body={s.body} detail={s.detail} points={s.points} eyebrow="Process step" enquirePrefix="Conformal Coating" />
      ))}
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="eyebrow">The coatings we apply</p>
        <h2 class="heading mt-4 text-2xl">ELPEGUARD® Conformal Coatings</h2>
        <p class="mt-3 max-w-2xl text-muted">Peters ELPEGUARD acrylic, polyurethane, silicone, thick-film UV-curing and aqua-based conformal coatings that protect and insulate assembled PCBs for higher reliability and service life.</p>
      </div>
      <a href="/datasheets/protecta-pro-esd-conductive-paint.pdf" class="btn-outline shrink-0" target="_blank" rel="noopener">Datasheet (PDF)</a>
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Need coating support at your line?</h2>
      <a href="/contact-us/?product=Conformal%20Coating%20Job%20Work" class="btn-primary mt-7">Request a quote</a>
    </div>
  </section>
</Layout>
