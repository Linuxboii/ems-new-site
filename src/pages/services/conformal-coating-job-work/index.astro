---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ApplicationCard from '@/components/ApplicationCard.astro';
import { services, serviceIntro } from '@/data/services';
import { engagement } from '@/data/serviceProcess';
import { breadcrumb, service, faq } from '@/lib/schema';

const title = 'Conformal Coating Job Work - On-Site Coating Services | EMS';
const description = 'On-site conformal coating job work across India: application, 100% UV inspection, curing, thickness testing, rework and final inspection by 30+ engineers.';
const path = '/services/conformal-coating-job-work/';

// Rendered on the page below and as FAQPage JSON-LD. Same facts as /services/.
const faqs = [
  {
    q: 'What does conformal coating job work from EMS include?',
    a: 'The full process: operating the coating equipment and applying the coating (brush, spray, dip or automatic selective coating), UV optical inspection, touch-up, drying and curing, coating thickness testing, selective removal and rework, and final inspection. The coatings applied are Peters ELPEGUARD acrylic, polyurethane, silicone, thick-film UV-curing and water-based systems.',
  },
  {
    q: 'Does EMS coat boards at our factory or at its own facility?',
    a: 'Both. EMS deploys 30+ trained engineers to run the agreed coating process on site at customer facilities across India, and also accepts boards sent to its Hyderabad facility. The right route depends on lot size, board handling constraints and how closely the coating step has to sit inside your line.',
  },
  {
    q: 'How is coating quality checked?',
    a: 'Every coated board is inspected under UV light rather than sampled, since ELPEGUARD coatings carry a UV tracer. Dry film thickness is measured against a band agreed at process sign-off, typically 25–75 µm for conventional systems, and assemblies are judged against IPC-A-610 workmanship criteria at the agreed acceptance class: Class 2 for most industrial and automotive electronics, Class 3 for life- or safety-critical assemblies.',
  },
  {
    q: 'How does a new conformal coating job start?',
    a: 'You send the board details and the environment it has to survive. EMS recommends a coating system and application method in writing, coats and inspects a sample or pilot lot to prove masking, coverage, thickness and cure, then fixes the parameters on a process sheet that repeat lots run to. Timing is confirmed against lot size, board and location at quotation.',
  },
  {
    q: 'Can conformal coated boards be reworked?',
    a: 'Yes. Selective coating removal, repair support and re-coating are part of the same job work programme. Acrylic is the easiest chemistry to rework; polyurethane and silicone need more deliberate removal, so the chemistry chosen at design stage largely decides how simple field repair will be.',
  },
];

const jsonLd = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: 'Conformal Coating Job Work', path },
  ]),
  service({
    name: 'Conformal coating job work',
    description,
    path,
    serviceType: 'Conformal coating job work',
    steps: engagement.map((e) => ({ name: e.stage.replace(/^\d+\s—\s/, ''), description: e.what })),
  }),
  faq(faqs),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="Services · Job work" title="Conformal Coating Job Work" lead={serviceIntro} />
  <section class="section container-x">
    <p class="eyebrow">Process</p>
    <h2 class="heading mt-4 text-2xl sm:text-3xl">What the job work covers</h2>
    <p class="mt-3 text-sm text-accent2">Click any card to read more about that step.</p>
    <div class="mt-8 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <ApplicationCard id={`cc-${i}`} title={s.title} img={s.img} body={s.body} detail={s.detail} points={s.points} eyebrow="Process step" enquirePrefix="Conformal Coating" />
      ))}
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="eyebrow">The coatings we apply</p>
        <h2 class="heading mt-4 text-2xl">ELPEGUARD® Conformal Coatings</h2>
        <p class="mt-3 max-w-2xl text-muted">Peters ELPEGUARD acrylic, polyurethane, silicone, thick-film UV-curing and aqua-based conformal coatings that protect and insulate assembled PCBs for higher reliability and service life.</p>
      </div>
      <a href="/downloads/" class="btn-outline shrink-0">ELPEGUARD datasheets</a>
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="heading mt-5 text-2xl sm:text-3xl">Conformal coating job work: quick answers</h2>
      <div class="mt-8 space-y-8">
        {faqs.map((f) => (
          <div>
            <h3 class="font-semibold text-ink">{f.q}</h3>
            <p class="mt-2 text-muted leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Need coating support at your line?</h2>
      <a href="/contact-us/?product=Conformal%20Coating%20Job%20Work" class="btn-primary mt-7">Request a quote</a>
    </div>
  </section>
</Layout>
