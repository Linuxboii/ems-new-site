---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ApplicationCard from '@/components/ApplicationCard.astro';
import { esdPaintApplications, esdPaintIntro } from '@/data/services';
import { breadcrumb, service, faq } from '@/lib/schema';

const title = 'ESD Paint Job Work - Conductive Floor & Surface Coating | EMS';
const description = 'On-site ProtectA Pro ESD conductive and anti-static paint: surface prep, conductive primer and earthing, topcoat, resistance testing and handover.';
const path = '/services/esd-paint-job-work/';

// Rendered on the page below and as FAQPage JSON-LD.
const faqs = [
  {
    q: 'What does ESD paint job work cover?',
    a: 'On-site application of ProtectA Pro ESD conductive and anti-static paints, covering surface preparation, conductive primer and earthing, topcoat application, and resistance testing after cure to confirm the finished surface reads in the intended dissipative range, followed by handover.',
  },
  {
    q: 'Which surfaces can be ESD painted?',
    a: 'Floors, walls and work surfaces in cleanrooms and production areas; conveyor belts and conveyor structures; polypropylene bins, crates and racking; EVA foam inserts and packaging; and storage or transport systems for flammable materials where an electrostatic discharge is a safety hazard.',
  },
  {
    q: 'How is an ESD painted floor verified?',
    a: 'The applied system is earthed and its surface resistance is tested after cure, so the handover confirms the floor or surface actually dissipates charge in the intended range rather than relying on the paint specification alone.',
  },
  {
    q: 'Which industries use ESD paint job work?',
    a: 'Electronics assembly, automotive, aerospace, warehousing and logistics facilities, plus petroleum storage and fuel handling areas where static control is a safety requirement.',
  },
];

const jsonLd = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: 'ESD Paint Job Work', path },
  ]),
  service({
    name: 'ESD paint job work',
    description,
    path,
    serviceType: 'ESD conductive and anti-static paint application',
  }),
  faq(faqs),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="Services · Job work" title="ESD Paint Job Work" lead={esdPaintIntro} />
  <section class="section container-x">
    <p class="eyebrow">Applications</p>
    <h2 class="heading mt-4 text-2xl sm:text-3xl">Where we apply it</h2>
    <p class="mt-3 text-sm text-accent2">Click any card to read more about that application.</p>
    <div class="mt-8 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {esdPaintApplications.map((s, i) => (
        <ApplicationCard id={String(i)} title={s.title} img={s.img} body={s.body} detail={s.detail} points={s.points} />
      ))}
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="eyebrow">The coating we apply</p>
        <h2 class="heading mt-4 text-2xl">ProtectA Pro: ESD Conductive &amp; Anti-Static Paints</h2>
        <p class="mt-3 max-w-2xl text-muted">An advanced range of ESD conductive and anti-static paints for floors, walls, surfaces and polypropylene bins, built on a conductive polymer matrix for stable, durable electrostatic protection in industrial environments.</p>
      </div>
      <a href="/datasheets/protecta-pro-esd-conductive-paint.pdf" class="btn-outline shrink-0" target="_blank" rel="noopener">Datasheet (PDF)</a>
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="heading mt-5 text-2xl sm:text-3xl">ESD paint job work: quick answers</h2>
      <div class="mt-8 space-y-8">
        {faqs.map((f) => (
          <div>
            <h3 class="font-semibold text-ink">{f.q}</h3>
            <p class="mt-2 text-muted leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Planning an ESD floor or workspace?</h2>
      <a href="/contact-us/?product=ESD%20Paint%20Job%20Work" class="btn-primary mt-7">Request a site visit</a>
    </div>
  </section>
</Layout>
