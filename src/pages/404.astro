---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Page not found - EMS Technologies" description="The page you are looking for could not be found." path="/404">
  <section class="section container-x text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="heading text-4xl sm:text-5xl mt-5">Page not found</h1>
    <p class="mt-4 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Layout>
