---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { company } from '@/data/company';

const title = 'Contact EMS Technologies - Hyderabad, Telangana';
const description = 'Contact EMS Technologies for Peters conformal coatings, ESD packing and coating job work. Call +91-9394116660 or email info@emstechnologies.in. Based in Hyderabad, Telangana.';
// Enquiries are delivered to company.email. The site is static, so the form
// posts to a form-relay service rather than a backend of our own; set
// PUBLIC_CONTACT_ENDPOINT to move to a different provider without code changes.
// The plain URL is the no-JS target (it redirects); JS posts to /ajax/ instead
// so the visitor stays on the page.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || `https://formsubmit.co/${company.email}`;
const ajaxEndpoint = endpoint.replace('https://formsubmit.co/', 'https://formsubmit.co/ajax/');
---
<Layout title={title} description={description} path="/contact-us/">
  <PageHero eyebrow="Contact" title="Contact Us" lead="Tell us about your conformal coating or ESD packing requirement and our engineers will get back to you promptly." />

  <section class="section container-x grid lg:grid-cols-2 gap-12">
    <div>
      <h2 class="heading text-2xl">Send us a message</h2>
      <p class="text-sm text-muted mt-1">We'll get back to you as soon as possible.</p>
      <p id="productBadge" class="mt-4 hidden rounded-lg bg-surface border border-line px-4 py-3 text-sm text-ink">Enquiry about: <span id="productBadgeName" class="font-semibold text-accent2"></span></p>
      <form id="contactForm" class="mt-6 space-y-4" method="POST" action={endpoint}>
        <input type="hidden" name="product" id="productField" />
        <input type="hidden" name="_subject" id="subjectField" value="Website enquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        {/* Bots fill hidden fields; a submission with this set is dropped. */}
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div class="grid sm:grid-cols-2 gap-4">
          <input required name="name" placeholder="Full name" class="w-full rounded-lg border border-line bg-surface text-ink placeholder:text-muted px-4 py-3 min-h-[44px]" />
          <input required type="email" name="email" placeholder="Email" class="w-full rounded-lg border border-line bg-surface text-ink placeholder:text-muted px-4 py-3 min-h-[44px]" />
          <input name="mobile" placeholder="Mobile" class="w-full rounded-lg border border-line bg-surface text-ink placeholder:text-muted px-4 py-3 min-h-[44px]" />
          <input name="company" placeholder="Company name" class="w-full rounded-lg border border-line bg-surface text-ink placeholder:text-muted px-4 py-3 min-h-[44px]" />
        </div>
        <textarea required name="message" rows="5" placeholder="Message" class="w-full rounded-lg border border-line bg-surface text-ink placeholder:text-muted px-4 py-3"></textarea>
        <button id="submitBtn" type="submit" class="btn-primary">Send message</button>
        <p id="formNote" class="text-sm text-accent2 hidden">Thanks — your enquiry has been sent to our team. We'll get back to you shortly.</p>
        <p id="formFallback" class="text-sm text-muted hidden">Couldn't send that. Please email us directly at <a id="fallbackLink" class="text-accent2 hover:underline" href={`mailto:${company.email}`}>{company.email}</a>.</p>
      </form>
    </div>

    <div class="space-y-6">
      <div>
        <h3 class="font-semibold text-ink">Address</h3>
        <p class="text-muted">{company.location}</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Call us</h3>
        {company.phones.map((p) => (<p><a class="text-accent2 hover:underline" href={`tel:${p.replaceAll('-', '')}`}>{p}</a></p>))}
      </div>
      <div>
        <h3 class="font-semibold text-ink">Mail us</h3>
        <a class="text-accent2 hover:underline" href={`mailto:${company.email}`}>{company.email}</a>
      </div>
      <div>
        <h3 class="font-semibold text-ink">WhatsApp</h3>
        <a class="inline-flex items-center gap-2 mt-1 text-accent2 hover:underline" href="https://wa.me/919394116660" target="_blank" rel="noopener" aria-label="Chat with EMS Technologies on WhatsApp">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="#25D366" aria-hidden="true" class="shrink-0">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span>+91 93941 16660</span>
        </a>
      </div>
      <iframe title="EMS Technologies location" class="w-full h-64 rounded-2xl border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps?q=Hyderabad,Telangana,India&output=embed"></iframe>
    </div>
  </section>
</Layout>
<script is:inline define:vars={{ ajaxEndpoint, email: company.email }}>
  const form = document.getElementById('contactForm');
  const note = document.getElementById('formNote');

  // Prefill from ?product= (e-commerce enquiry flow). Photos/products across the
  // site link here as /contact-us/?product=<name>.
  const product = new URLSearchParams(location.search).get('product');
  if (product) {
    document.getElementById('productField').value = product;
    const badge = document.getElementById('productBadge');
    document.getElementById('productBadgeName').textContent = product;
    badge.classList.remove('hidden');
    const msg = form?.querySelector('[name="message"]');
    if (msg && !msg.value) msg.value = `I would like to enquire about: ${product}.\nPlease share product details, availability and pricing.`;
  }
  const subject = product ? `Enquiry: ${product}` : 'Website enquiry';
  const subjectField = document.getElementById('subjectField');
  if (subjectField) subjectField.value = subject;

  const fallback = document.getElementById('formFallback');
  const fallbackLink = document.getElementById('fallbackLink');
  const submitBtn = document.getElementById('submitBtn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);

    // Prepare the mailto up front: it is what we offer if the send fails.
    // Cap the message so the URL stays under browser length limits
    // (long mailto: URLs silently fail to open a mail client).
    const message = String(f.get('message') || '').slice(0, 1200);
    const bodyText = `Name: ${f.get('name')}\nEmail: ${f.get('email')}\nMobile: ${f.get('mobile')}\nCompany: ${f.get('company')}\nProduct: ${f.get('product') || '-'}\n\n${message}`;
    if (fallbackLink) fallbackLink.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;

    note?.classList.add('hidden');
    fallback?.classList.add('hidden');
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

    try {
      const res = await fetch(ajaxEndpoint, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: f,
      });
      if (!res.ok) throw new Error(String(res.status));
      note?.classList.remove('hidden');
      form.reset();
      if (subjectField) subjectField.value = subject;
      const productField = document.getElementById('productField');
      if (productField && product) productField.value = product;
    } catch {
      // Network down, blocked, or the relay is unreachable — offer direct email.
      fallback?.classList.remove('hidden');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send message'; }
    }
  });
</script>
