---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import AssetImage from '@/components/AssetImage.astro';
import { industries } from '@/data/industries';
import { breadcrumb, service, faq } from '@/lib/schema';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const path = `/industries/${industry.slug}/`;

const jsonLd = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/industries/' },
    { name: industry.name, path },
  ]),
  service({
    name: `Conformal coating and ESD packing for ${industry.name.toLowerCase()}`,
    description: industry.seoDescription,
    path,
    serviceType: 'Conformal coating job work',
  }),
  faq(industry.faqs),
];
---
<Layout title={industry.seoTitle} description={industry.seoDescription} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="Industries" title={industry.heading} lead={industry.lead} />

  <section class="section border-b border-line container-x grid gap-12 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5">
      <div class="overflow-hidden rounded-xl border border-line bg-surface">
        <AssetImage name={industry.img} alt={industry.imgAlt} width={640} height={480} class="w-full object-cover" />
      </div>
    </div>
    <div class="lg:col-span-7">
      <p class="eyebrow">What the environment does</p>
      <h2 class="heading mt-5 text-2xl sm:text-3xl">The stresses that decide the specification</h2>
      <div class="mt-8 space-y-7">
        {industry.stresses.map((s) => (
          <div class="border-t border-line pt-6">
            <h3 class="heading text-base text-ink">{s.title}</h3>
            <p class="mt-3 text-muted leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-b border-line container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">Coating systems</p>
      <h2 class="heading mt-5 text-2xl sm:text-3xl">What is typically specified here</h2>
      <p class="mt-6 text-muted leading-relaxed">Sector convention is a starting point, not an answer — the environment specification decides. Our engineers will confirm the grade against your actual assembly.</p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {industry.coatings.map((c) => (
        <div class="rounded-xl border border-line bg-surface p-6">
          <h3 class="heading text-base text-ink">{c.name}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed">{c.why}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-sm text-muted">Full comparison: <a class="text-accent2 hover:underline" href="/resources/acrylic-vs-polyurethane-vs-silicone/">acrylic vs polyurethane vs silicone</a> · Selection method: <a class="text-accent2 hover:underline" href="/resources/conformal-coating-selection-guide/">how to choose a conformal coating</a></p>
  </section>

  <section class="section border-b border-line container-x grid gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">ESD packing</p>
      <h2 class="heading mt-5 text-2xl">Getting the assembly there intact</h2>
      <ul class="mt-8 space-y-3 text-muted">
        {industry.packing.map((p) => (
          <li class="flex gap-3 leading-relaxed"><span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent2"></span><span>{p}</span></li>
        ))}
      </ul>
      <a href="/EsdBags/" class="btn-outline mt-8">ESD packing range</a>
    </div>
    <div>
      <p class="eyebrow">Standards</p>
      <h2 class="heading mt-5 text-2xl">What gets specified</h2>
      <p class="mt-8 text-muted leading-relaxed">{industry.standards}</p>
      <a href="/resources/conformal-coating-standards/" class="btn-outline mt-8">Standards explainer</a>
    </div>
  </section>

  <section class="section border-b border-line container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="heading mt-5 text-2xl sm:text-3xl">{industry.name} questions</h2>
    </div>
    <div class="mt-10 grid gap-x-12 gap-y-8 lg:grid-cols-2">
      {industry.faqs.map((f) => (
        <div>
          <h3 class="font-semibold text-ink">{f.q}</h3>
          <p class="mt-2 text-muted leading-relaxed">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <h2 class="heading text-2xl sm:text-3xl">Coating for {industry.name.toLowerCase()}?</h2>
      <p class="mt-5 text-muted leading-relaxed">Send us the assembly, the environment it has to survive and the standard you are working to. Our engineers come back with a coating system, an application method and a window.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`/contact-us/?product=${encodeURIComponent(`Conformal coating — ${industry.name}`)}`} class="btn-primary">Request a quote</a>
        <a href="/industries/" class="btn-outline">Other industries</a>
      </div>
    </div>
  </section>
</Layout>
