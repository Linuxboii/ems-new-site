---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ProductIntro from '@/components/ProductIntro.astro';
import ProductCard from '@/components/ProductCard.astro';
import GallerySection from '@/components/GallerySection.astro';
import { esdBags } from '@/data/esdBags';
import { gallery } from '@/data/gallery';
import { galleryJsonLd, breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'ESD Bags - Bubble, Static Shielding, LDPE Pink & Conductive | EMS';
const description = 'ESD packing bags from EMS Technologies, Hyderabad: anti-static bubble bags, static shielding bags, LDPE pink bags and conductive grid bags for safe electronics packing.';
const path = '/EsdBags/';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    { name: 'ESD Bags', path },
  ]),
  await galleryJsonLd('ESD Bags', description, path, [gallery.bubble, gallery.grid, gallery.shield, gallery.mbb, gallery.pink]),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="ESD Packing" title="ESD Bags" lead="Anti-static packing bags that protect electronics from static discharge, moisture and physical shock: bubble, static-shielding, LDPE pink and conductive grid types." />
  <ProductIntro path={path} />
  <section class="section container-x">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {esdBags.map((b) => <ProductCard title={b.title} href={b.href} img={b.img} blurb={b.blurb} />)}
    </div>
  </section>
  <GallerySection id="pink-bubble-bags" title="Pink Bubble Bags" enquire="Pink Bubble Bags" images={gallery.bubble.images} blurb="Cushioned pink anti-static bubble bags that guard components against both shock and static. The bubble layer absorbs impact and vibration in transit while the anti-static film stops a charge building on the surface, so boards and parts that need physical protection as well as ESD safety are covered by a single bag." />
  <GallerySection id="conductive-grid-bags" title="Conductive Grid Bags" enquire="Conductive Grid Bags" images={gallery.grid.images} blurb="Conductive grid bags printed with a diamond pattern that continuously dissipates static charge during storage and transit. The buried conductive grid holds the whole surface at an even potential, making them a low-cost, hard-wearing choice for storing and moving bare boards and loose components on the shop floor." />
  <GallerySection id="static-shielding-bags" title="Static Shielding Bags" enquire="Static Shielding Bags" images={gallery.shield.images} blurb="Metallised static shielding bags that form a Faraday cage around the contents, blocking an external discharge from ever reaching the electronics inside. The semi-transparent film lets you identify a board without opening the bag, and the grades are supplied plain or zip-lock for repeated opening and resealing." />
  <GallerySection id="aluminium-mbb-bags" title="Aluminium Bags (MBB)" enquire="Aluminium MBB Bags" images={gallery.mbb.images} blurb="Silver, aluminium-laminated bags, also known as aluminium bags or MBB (moisture barrier bags). On top of the static-shielding Faraday cage, the aluminium foil layer adds a barrier against humidity, so moisture-sensitive assemblies stay dry as well as protected from discharge — the usual choice for long-term storage and export packing, often heat-sealed with a desiccant inside." />
  <GallerySection id="ldpe-pink-bags" title="LDPE Pink Bags" enquire="LDPE Pink Anti-Static Bags" images={gallery.pink.images} blurb="Anti-static pink LDPE bags for general electronics packing and storage where shielding and cushioning are not required. The pink anti-static film prevents charge building up on the bag surface, making them an economical everyday bag for boards, sub-assemblies and components in bulk." />
</Layout>
