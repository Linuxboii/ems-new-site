---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import GallerySection from '@/components/GallerySection.astro';
import { galleryShowcase } from '@/data/gallery';
import { galleryJsonLd, breadcrumbJsonLd } from '@/lib/galleryJsonLd';

const title = 'Gallery - ESD Packing & Coating Photos | EMS Technologies';
const description = 'Photo gallery of EMS Technologies ESD packing: anti-static and static shielding bags, EVA bins, EPE foam inserts, PET and HIPS thermoformed trays and material swatches.';
const path = '/gallery/';

// One section per group of the studio photography. `detail` keys the write-up
// shown beside the enlarged photo when a section's images are opened.
const sections = [
  { key: 'thermoformedBlack', id: 'black-trays', detail: 'hips-trays', blurb: 'Black conductive thermoformed trays, pockets tooled to the component and part numbers moulded into the rim.' },
  { key: 'thermoformedWhite', id: 'white-trays', detail: 'white-trays', blurb: 'White thermoformed trays, where a light background makes the part and its orientation easier to check.' },
  { key: 'ppCorrugated', id: 'pp-corrugated', detail: 'pp-corrugated', blurb: 'PP corrugated bins, boxes and trays with twin-wall dividers, riveted corners and carry slots.' },
  { key: 'conductiveFoam', id: 'conductive-foam', detail: 'conductive-foam-packing', blurb: 'Conductive foam boxes and inserts routed to hold each part in its own pocket.' },
  { key: 'epeFoam', id: 'epe-foam', detail: 'epe-foam-trays', blurb: 'EPE foam trays cut to component geometry for cushioned, static-safe handling.' },
  { key: 'custom', id: 'custom', detail: 'custom-packing', blurb: 'Shaped presentation packs, PP honeycomb pallet tops and conductive reels, all made to a drawing.' },
].map((s) => ({ ...s, group: galleryShowcase[s.key] }));

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Gallery', path },
  ]),
  await galleryJsonLd('EMS Technologies Gallery', description, path, sections.map((s) => s.group)),
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero eyebrow="Photos" title="Gallery" lead="Product photography across the EMS Technologies ESD packing range: bags, bins, foam inserts, thermoformed trays and the materials they are made from.">
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Gallery sections">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:border-accent2 hover:text-accent2">{s.group.label}</a>
      ))}
    </nav>
  </PageHero>
  {sections.map((s) => (
    <GallerySection id={s.id} title={s.group.label} enquire={s.group.label} images={s.group.images} blurb={s.blurb} detailKey={s.detail} />
  ))}
  <section class="section border-t border-line">
    <div class="container-x text-center max-w-2xl">
      <h2 class="heading text-2xl sm:text-3xl">Looking for something in a custom size?</h2>
      <p class="mt-3 text-muted">Tell us the part and the quantity, and we will quote the right packing for it.</p>
      <a href="/contact-us/" class="btn-primary mt-7">Get a quote</a>
    </div>
  </section>
</Layout>
